#version 430 core

in vec2 uv;
layout(location = 0) out vec4 fragment;
layout(binding = 0) uniform sampler2D blurred;
layout(binding = 1) uniform sampler2D silhouette;
uniform vec4 parameters[4];

#define c0 parameters[0]
#define c1 parameters[1]
#define c2 parameters[2]
#define c3 parameters[3]
#define float2 vec2
#define float3 vec3
#define float4 vec4
#define frac fract
#define lerp mix
#define STYLE_BRANCH
#define STYLE_UNROLL
#define STYLE_RANGE_REDUCE
#define STYLE_MAD fma

// Style coordinates follow Direct3D's upper-left origin.
vec2 texture_uv(vec2 p) { return vec2(p.x, 1.0 - p.y); }
#define SAMPLE_GLOW(p) textureLod(blurred, texture_uv(p), 0.0).r
#define SAMPLE_BODY(p) textureLod(silhouette, texture_uv(p), 0.0).r

float saturate(float x) { return clamp(x, 0.0, 1.0); }
vec3 saturate(vec3 x) { return clamp(x, 0.0, 1.0); }
vec2 fmod(vec2 x, vec2 y) { return x - y * trunc(x / y); }

// Keep a division that rounded up to an integer from putting a pixel into
// the next grid cell when its position still falls short of that boundary.
float grid_cell(float p, float texel, float spacing)
{
    precise float pixel = p / texel;
    precise float cell = floor(pixel / spacing);
    precise float residual = fma(-cell, spacing, pixel);
    return cell - float(residual < 0.0);
}
#define STYLE_GRID_CELL grid_cell
